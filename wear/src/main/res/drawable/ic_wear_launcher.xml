<?xml version="1.0" encoding="utf-8"?>
<!--
    Wear OS 런처 아이콘 — phone 의 ic_launcher_foreground/background 와 시각적 일관.
    배경: 핑크→빨강 대각선 그라데이션 (phone background 와 동일 색상).
    전경: 흰색 EKG 펄스 (phone foreground 및 splash 와 동일 path).

    Wear OS 는 워치 런처에서 자동으로 원형 mask 를 적용 → 정사각형 vector 그려도 OK.
    EKG path 가 안쪽 (X 28-80, Y 30-72) 에 위치해 mask 잘림 안전.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 배경 — 핑크 → HR 빨강 그라데이션 (phone ic_launcher_background.xml 와 일치) -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="108" android:endY="108"
                android:startColor="#FFB5C5"
                android:endColor="#FF2D55" />
        </aapt:attr>
    </path>

    <!-- EKG 펄스 — 흰색 stroke, phone 아이콘과 동일 path -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M28,54 L42,54 L46,60 L52,72 L58,30 L64,54 L80,54" />
</vector>
