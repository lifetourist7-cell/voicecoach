<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch"/>

    <!-- HR 측정 권한 -->
    <uses-permission android:name="android.permission.BODY_SENSORS"/>
    <!-- 측정 중 화면 꺼져도 동작 -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH"/>
    <!-- Foreground service 알림 (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_wear_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.VoiceCoachWear">

        <uses-library
            android:name="com.google.android.wearable"
            android:required="true"/>

        <!-- standalone=false — 워치 단독으로는 BPM 표시만 가능, 핵심 기능 (음성 코칭 / Meditation
             / BLE 흉부 스트랩 fallback) 은 폰 앱이 있어야 동작.  Companion 성격이 명확해서
             Google 의 standalone 검증 통과를 위해 false 로 선언. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="false"/>

        <!--
            Capability 광고는 res/values/wear.xml 의 "android_wear_capabilities"
            string-array 로 처리. 시스템이 array name 을 자동 인식 → 별도 manifest
            meta-data 불필요. (이전엔 커스텀 array name + meta-data resource 포인터를
            썼지만 공식 권장 방식이 아님.)
        -->


        <!--
            namespace = com.jecheon.voicecoach.wear 라 ".XYZ" 가 곧 fully qualified
            com.jecheon.voicecoach.wear.XYZ. 과거에 ".wear.XYZ" 로 적어 merged manifest 에서
            com.jecheon.voicecoach.wear.wear.XYZ 로 들어가 클래스 미존재 → 런처/서비스 미동작.
        -->
        <activity
            android:name=".WearMainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <service
            android:name=".HrSenderService"
            android:exported="false"
            android:foregroundServiceType="health"/>

        <!-- 폰 앱이 보내는 시작/정지 명령 수신 -->
        <service
            android:name=".PhoneCommandListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED"/>
                <data android:scheme="wear" android:host="*" android:pathPrefix="/start_hr_sender"/>
                <data android:scheme="wear" android:host="*" android:pathPrefix="/stop_hr_sender"/>
            </intent-filter>
        </service>

    </application>
</manifest>
