<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="@dimen/space_xl"
        android:paddingEnd="@dimen/space_xl"
        android:paddingTop="@dimen/space_xl">

        <ImageView
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:src="@drawable/illust_setup_done"
            android:layout_marginBottom="@dimen/space_l"
            android:contentDescription="셋업 완료"/>

        <TextView
            android:id="@+id/tvSetupTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="셋업 안내"
            android:textAppearance="@style/TextAppearance.VC.Headline"
            android:textAlignment="center"
            android:layout_marginBottom="@dimen/space_l"/>

        <TextView
            android:id="@+id/tvSetupBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textAppearance="@style/TextAppearance.VC.Body"
            android:textColor="@color/text_secondary"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="@dimen/space_xl"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="나중에 상단 (?) 아이콘으로 다시 볼 수 있습니다."
            android:textAppearance="@style/TextAppearance.VC.Caption"
            android:textAlignment="center"
            android:layout_marginBottom="@dimen/space_xl"/>
    </LinearLayout>
</ScrollView>
