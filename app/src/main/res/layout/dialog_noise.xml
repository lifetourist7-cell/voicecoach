<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_l"
    android:paddingEnd="@dimen/space_l"
    android:paddingTop="@dimen/space_s"
    android:paddingBottom="@dimen/space_s">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="저역통과 컷오프 주파수를 조정합니다.\n낮을수록 저음이 강조되고(브라운에 가깝고), 높을수록 전대역(화이트에 가까움)이 됩니다."
        android:textAppearance="@style/TextAppearance.VC.Caption"
        android:layout_marginBottom="@dimen/space_m"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="컷오프 주파수"
        android:textAppearance="@style/TextAppearance.VC.Label"
        android:textStyle="bold"/>

    <!-- 직접 입력 가능한 EditText + ± 버튼 + Hz 라벨. 슬라이더와 양방향 동기화. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="@dimen/space_xs"
        android:layout_marginBottom="@dimen/space_s">

        <Button
            android:id="@+id/btnNoiseCutoffMinus"
            style="@style/Widget.VC.Button.Stepper.Compact"
            android:text="−"
            android:contentDescription="주파수 1Hz 감소"/>

        <EditText
            android:id="@+id/etNoiseCutoff"
            style="@style/Widget.VC.EditText.Number"
            android:layout_width="96dp"
            android:textColor="@color/pace_electric_blue"
            android:layout_marginStart="@dimen/space_s"
            android:layout_marginEnd="@dimen/space_s"
            android:text="5000"/>

        <Button
            android:id="@+id/btnNoiseCutoffPlus"
            style="@style/Widget.VC.Button.Stepper.Compact"
            android:text="+"
            android:contentDescription="주파수 1Hz 증가"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hz"
            android:textAppearance="@style/TextAppearance.VC.Body"
            android:textColor="@color/pace_electric_blue"
            android:layout_marginStart="@dimen/space_s"/>
    </LinearLayout>

    <SeekBar
        android:id="@+id/seekNoiseCutoff"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="9990"
        android:progress="4990"
        android:layout_marginBottom="@dimen/space_xs"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="@dimen/space_m">
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="저음 (브라운)"
            android:textAppearance="@style/TextAppearance.VC.Caption"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="전대역 (화이트)"
            android:textAppearance="@style/TextAppearance.VC.Caption"/>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="음량"
        android:textAppearance="@style/TextAppearance.VC.Label"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/tvNoiseVolume"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="50%"
        android:textAppearance="@style/TextAppearance.VC.Body"
        android:textColor="@color/pace_electric_blue"
        android:layout_marginBottom="@dimen/space_xs"/>

    <SeekBar
        android:id="@+id/seekNoiseVolume"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100"
        android:progress="50"
        android:layout_marginBottom="@dimen/space_s"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="※ 슬라이더는 노이즈 재생 중 실시간 반영됩니다."
        android:textAppearance="@style/TextAppearance.VC.Caption"
        android:layout_marginTop="@dimen/space_s"/>

</LinearLayout>
