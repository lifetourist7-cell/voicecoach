<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_deep">

    <!-- ── 상단 바 ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/space_s"
        android:paddingEnd="@dimen/space_m"
        android:paddingTop="@dimen/space_m"
        android:paddingBottom="@dimen/space_m">

        <ImageButton
            android:id="@+id/btnHelpBack"
            style="@style/Widget.VC.Button.Icon"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/text_secondary"
            android:contentDescription="뒤로"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_xs"
            android:text="도움말"
            android:textAppearance="@style/TextAppearance.VC.Title"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_m"
            android:paddingEnd="@dimen/space_m"
            android:paddingBottom="@dimen/space_xl">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="궁금한 항목을 탭하세요"
                android:textAppearance="@style/TextAppearance.VC.Caption"
                android:layout_marginBottom="@dimen/space_l"/>

            <!-- ── 워치 셋업 ── -->
            <TextView
                style="@style/SectionLabel"
                android:text="워치 셋업"/>

            <LinearLayout
                android:id="@+id/cardBleSetup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="@dimen/space_m"
                android:layout_marginBottom="@dimen/space_s"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BLE 송출 워치 (가민 / 폴라 / 순토)"
                    android:textAppearance="@style/TextAppearance.VC.Body"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="블루투스 심박수 프로파일을 송출하는 워치 — 페어링 후 본 앱에서 직접 심박수를 받습니다."
                    android:textAppearance="@style/TextAppearance.VC.Caption"
                    android:layout_marginTop="@dimen/space_xs"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardWearSetup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="@dimen/space_m"
                android:layout_marginBottom="@dimen/space_s"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wear OS 워치 (갤럭시워치 4 이상 / 픽셀워치)"
                    android:textAppearance="@style/TextAppearance.VC.Body"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="워치 Play 스토어에서 컴패니언 앱 설치 + 권한 허용 — 자동 설치되는 경우도 있지만 항상 보장되지는 않아요."
                    android:textAppearance="@style/TextAppearance.VC.Caption"
                    android:layout_marginTop="@dimen/space_xs"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardNoWatch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="@dimen/space_m"
                android:layout_marginBottom="@dimen/space_l"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="워치 없이 사용"
                    android:textAppearance="@style/TextAppearance.VC.Body"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="심박수 기능 외에 메트로놈, 호흡 가이드, 노이즈 마스킹 등은 워치 없이도 사용 가능합니다."
                    android:textAppearance="@style/TextAppearance.VC.Caption"
                    android:layout_marginTop="@dimen/space_xs"/>
            </LinearLayout>

            <!-- ── 모드 사용법 ── -->
            <TextView
                style="@style/SectionLabel"
                android:text="모드 사용법"/>

            <LinearLayout
                android:id="@+id/cardModeRunning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="@dimen/space_m"
                android:layout_marginBottom="@dimen/space_s"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="달리기 — 심박수 / 페이스 음성 안내"
                    android:textAppearance="@style/TextAppearance.VC.Body"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="원하는 항목 (HR, 페이스) 토글 ON, 안내 간격 설정 후 시작."
                    android:textAppearance="@style/TextAppearance.VC.Caption"
                    android:layout_marginTop="@dimen/space_xs"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardModeGolf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="@dimen/space_m"
                android:layout_marginBottom="@dimen/space_s"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="골프 — 3:1 템포 메트로놈"
                    android:textAppearance="@style/TextAppearance.VC.Body"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="클럽 프리셋 (드라이버 / 아이언 / 웨지 / 퍼터) 길게 눌러 BPM 편집."
                    android:textAppearance="@style/TextAppearance.VC.Caption"
                    android:layout_marginTop="@dimen/space_xs"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardModeMeditation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="@dimen/space_m"
                android:layout_marginBottom="@dimen/space_l"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Meditation — 호흡 + 평균 심박수"
                    android:textAppearance="@style/TextAppearance.VC.Body"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="호흡 기법 선택 → 1분마다 평균 심박수 변화 안내."
                    android:textAppearance="@style/TextAppearance.VC.Caption"
                    android:layout_marginTop="@dimen/space_xs"/>
            </LinearLayout>

            <!-- ── 보이스 코치 / 호흡 ── -->
            <TextView
                style="@style/SectionLabel"
                android:text="추가 기능"/>

            <LinearLayout
                android:id="@+id/cardCoach"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="@dimen/space_m"
                android:layout_marginBottom="@dimen/space_s"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="보이스 코치 임계값"
                    android:textAppearance="@style/TextAppearance.VC.Body"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="달리기 모드에서 심박수가 임계값을 벗어나면 자동으로 음성 안내."
                    android:textAppearance="@style/TextAppearance.VC.Caption"
                    android:layout_marginTop="@dimen/space_xs"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardBreath"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="@dimen/space_m"
                android:layout_marginBottom="@dimen/space_s"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="호흡 기법 4종"
                    android:textAppearance="@style/TextAppearance.VC.Body"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="박스 / 4-7-8 / 4-2-6 / 사용자 정의 — 차이와 추천 사용 시나리오."
                    android:textAppearance="@style/TextAppearance.VC.Caption"
                    android:layout_marginTop="@dimen/space_xs"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardFocusSound"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="@dimen/space_m"
                android:layout_marginBottom="@dimen/space_s"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="집중 사운드의 근거"
                    android:textAppearance="@style/TextAppearance.VC.Body"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="백색/브라운 노이즈와 40Hz 바이노럴 비트의 연구 배경 + 안전 안내."
                    android:textAppearance="@style/TextAppearance.VC.Caption"
                    android:layout_marginTop="@dimen/space_xs"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
