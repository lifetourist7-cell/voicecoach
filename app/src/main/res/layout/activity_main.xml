<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:paddingTop="72dp"
            android:paddingBottom="32dp">

            <TextView
                android:id="@+id/tvHeartRate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-- BPM"
                android:textSize="48sp"
                android:textColor="#FF4444"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/tvPace"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--'--&quot;"
                android:textSize="48sp"
                android:textColor="#44AAFF"
                android:textStyle="bold"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="대기 중"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="48dp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <ToggleButton
                    android:id="@+id/btnHR"
                    android:layout_width="120dp"
                    android:layout_height="60dp"
                    android:textOn="HR ✓"
                    android:textOff="HR"
                    android:textSize="18sp"
                    android:layout_marginEnd="16dp"/>

                <ToggleButton
                    android:id="@+id/btnPace"
                    android:layout_width="120dp"
                    android:layout_height="60dp"
                    android:textOn="PACE ✓"
                    android:textOff="PACE"
                    android:textSize="18sp"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="읽기 간격: "
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"/>

                <Button
                    android:id="@+id/btnIntervalMinus"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="−"
                    android:textSize="22sp"
                    android:padding="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"/>

                <EditText
                    android:id="@+id/etInterval"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="3"
                    android:textSize="18sp"
                    android:textColor="#FFFFFF"
                    android:textAlignment="center"
                    android:backgroundTint="#FFFFFF"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="초 "
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"/>

                <Button
                    android:id="@+id/btnIntervalPlus"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="+"
                    android:textSize="22sp"
                    android:padding="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="언어: "
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"/>

                <Spinner
                    android:id="@+id/spinnerLanguage"
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#FFFFFF"/>

            </LinearLayout>

            <!-- 메트로놈 구분선 -->
            <View
                android:layout_width="300dp"
                android:layout_height="1dp"
                android:background="#444444"
                android:layout_marginBottom="24dp"/>

            <ToggleButton
                android:id="@+id/btnMetronome"
                android:layout_width="200dp"
                android:layout_height="60dp"
                android:textOn="메트로놈 ON ✓"
                android:textOff="메트로놈"
                android:textSize="16sp"
                android:layout_marginBottom="16dp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="32dp">

                <Button
                    android:id="@+id/btnBpmMinus"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="−"
                    android:textSize="22sp"
                    android:padding="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"/>

                <EditText
                    android:id="@+id/etMetronomeBpm"
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="180"
                    android:textSize="18sp"
                    android:textColor="#FFFFFF"
                    android:textAlignment="center"
                    android:backgroundTint="#FFFFFF"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BPM "
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"/>

                <Button
                    android:id="@+id/btnBpmPlus"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="+"
                    android:textSize="22sp"
                    android:padding="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"/>

            </LinearLayout>

            <!-- 구분선 -->
            <View
                android:layout_width="300dp"
                android:layout_height="1dp"
                android:background="#444444"
                android:layout_marginBottom="24dp"/>

            <Button
                android:id="@+id/btnStart"
                android:layout_width="200dp"
                android:layout_height="60dp"
                android:text="시작"
                android:textSize="20sp"/>

        </LinearLayout>

    </ScrollView>

    <ImageButton
        android:id="@+id/btnSettings"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:src="@android:drawable/ic_menu_preferences"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:tint="#FFFFFF"
        android:contentDescription="설정"/>

</FrameLayout>
