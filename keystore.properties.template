# ─── VoiceCoach Release Signing Config ────────────────────────────────────
#
# 사용법:
#   1. 이 파일을 같은 디렉토리에 "keystore.properties" 로 복사
#      (cp keystore.properties.template keystore.properties)
#   2. 아래 빈 칸 4개 채우기 — 이전 v1.0/v1.2 업로드 때 만든 keystore creds.
#   3. ./gradlew :app:bundleRelease :wear:bundleRelease 실행
#   4. AAB 가 자동으로 release 키로 서명되어 Play Console 업로드 가능 상태로 떨어짐.
#
# keystore.properties 는 .gitignore 에 등록됨 — git 에 올라가지 않음.
# 이 .template 파일만 커밋되어 다른 머신/협업자에게 빈 칸 가이드 제공.
#
# ──────────────────────────────────────────────────────────────────────────

# 키스토어 파일 절대 경로 (이미 hrmonitor.jks 가 홈 디렉토리에 있음)
storeFile=/Users/johndoe/hrmonitor.jks

# 키스토어 자체 비밀번호 — Android Studio Generate Signed Bundle 마법사에서
# 처음 생성했을 때 입력한 store password
storePassword=

# 키 alias 이름 — 보통 voicecoach / hrmonitor / key0 같은 짧은 이름
keyAlias=

# alias 의 비밀번호 — 보통 storePassword 와 같게 설정함 (Android Studio 기본)
keyPassword=
